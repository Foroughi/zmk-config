#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        htl: htl {
            compatible = "zmk,behavior-hold-tap";
            label = "Hold Tab Switch Later";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <50>;
            hold-while-undecided;
        };

        valheim_dodge: valheim_dodge {
            compatible = "zmk,behavior-hold-tap";
            label = "VALHEIM_DODGE";
            bindings = <&kp>, <&valheim_dodge_macro>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            hold-trigger-key-positions = <13 14 15 2>;
        };
    };

    macros {
        valheim_dodge_macro: valheim_dodge {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_wait_time 30>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LCTRL &macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "VALHEIM_DODGE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "L1";
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E             &kp R     &kp T           &kp Y         &kp U  &kp I       &kp O      &kp P          &kp BACKSPACE
&kp TAB     &kp A  &kp S  &kp D             &kp F     &kp G           &kp H         &kp J  &kp K       &kp L      &kp SEMICOLON  &kp SPACE
&kp LSHIFT  &kp Z  &kp X  &kp C             &kp V     &kp B           &kp N         &kp M  &kp PERIOD  &kp COMMA  &none          &kp RSHIFT
                          &kp LEFT_CONTROL  &kp LCMD  &kp LEFT_ALT    &htl 1 ENTER  &mo 2  &mo 3
            >;

            label = "L0";
        };

        L1 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "L1";
            bindings = <
&none  &kp EXCLAMATION  &kp AT_SIGN        &kp HASH      &kp DOLLAR     &kp PERCENT         &kp CARET             &kp AMPERSAND          &kp ASTERISK    &kp UNDERSCORE     &kp EQUAL   &none
&none  &kp GRAVE        &kp DOUBLE_QUOTES  &kp QUESTION  &kp LESS_THAN  &kp GREATER_THAN    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LBKT        &kp RIGHT_BRACKET  &kp COLON   &none
&none  &kp TILDE        &kp SINGLE_QUOTE   &kp PIPE      &kp SLASH      &kp BACKSLASH       &kp PLUS              &kp MINUS              &kp LEFT_BRACE  &kp RBRC           &kp PERIOD  &none
                                           &trans        &trans         &trans              &trans                &trans                 &trans
            >;

            label = "L1";
        };

        L2 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "L3";
            bindings = <
&none  &kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp HOME  &kp PAGE_UP    &msc SCRL_DOWN  &none      &none  &to 5
&none  &kp NUMBER_6      &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0    &kp LEFT  &kp DOWN       &kp UP_ARROW    &kp RIGHT  &none  &none
&none  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp GRAVE     &kp COLON     &kp DOT         &kp END   &kp PAGE_DOWN  &msc SCRL_DOWN  &none      &none  &none
                                            &trans        &trans        &trans          &trans    &trans         &trans
            >;

            label = "L2";
        };

        L3 {
            bindings = <
&kp LG(ENTER)  &kp LA(NUMBER_1)      &kp LA(NUMBER_2)      &kp LA(NUMBER_3)      &kp LA(NUMBER_4)      &kp LA(NUMBER_5)        &kp LA(NUMBER_6)      &kp LA(N7)      &kp LA(NUMBER_8)      &kp LA(NUMBER_9)      &kp C_VOLUME_UP  &kp LG(PRINTSCREEN)
&kp LG(GRAVE)  &kp LG(NUMBER_1)      &kp LG(NUMBER_2)      &kp LG(NUMBER_3)      &kp LG(NUMBER_4)      &kp LG(NUMBER_5)        &kp LG(NUMBER_6)      &kp LG(N7)      &kp LG(NUMBER_8)      &kp LG(NUMBER_9)      &kp K_MUTE       &kp LG(PAUSE_BREAK)
&none          &kp LS(LG(NUMBER_1))  &kp LG(LS(NUMBER_2))  &kp LG(LS(NUMBER_3))  &kp LG(LS(NUMBER_4))  &kp LG(LS(NUMBER_5))    &kp LG(LS(NUMBER_6))  &kp LG(LS(N7))  &kp LG(LS(NUMBER_8))  &kp LG(LS(NUMBER_9))  &kp C_VOL_DN     &none
                                                           &trans                &trans                &trans                  &trans                &trans          &trans
            >;

            label = "L3";
        };

        L4 {
            bindings = <
&none  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none  &none
&none  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10    &none         &none         &none         &none         &none  &none
&none  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15    &none         &none         &none         &none         &none  &none
                         &none    &none    &none      &none         &none         &none
            >;

            label = "L4";
        };

        Valheim {
            bindings = <
&kp ESCAPE  &kp Q               &valheim_dodge W W  &kp NUMBER_1        &kp NUMBER_2   &kp NUMBER_3    &trans  &trans  &trans  &trans  &trans  &to 0
&kp TAB     &valheim_dodge A A  &valheim_dodge S S  &valheim_dodge D D  &kp E          &kp F           &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL   &kp Z               &kp X               &kp C               &kp NUMBER_6   &kp NUMBER_7    &trans  &trans  &trans  &trans  &trans  &kp NUMBER_8
                                                    &kp LEFT_SHIFT      &kp LC(SPACE)  &kp SPACE       &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        L4Activation {
            if-layers = <1 2>;
            then-layer = <4>;
        };

        L5Activation {
            if-layers = <1 3>;
            then-layer = <5>;
        };
    };
};
